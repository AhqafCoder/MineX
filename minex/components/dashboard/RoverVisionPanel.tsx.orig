"use client";

import { useState } from "react";
import { Camera, Maximize2 } from "lucide-react";
import { cn } from "@/lib/utils";
import type { DashboardState } from "@/app/dashboard/page";

interface Props {
  state: DashboardState;
}

export default function RoverVisionPanel({ state }: Props) {
  const [showOverlay, setShowOverlay] = useState(true);
  const [recording, setRecording] = useState(false);

  return (
    <div className="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
      {/* Header */}
      <div className="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <div className="flex items-center gap-3">
          <div className="w-8 h-8 bg-gray-50 rounded-lg flex items-center justify-center">
            <Camera className="w-4 h-4 text-purple-600" />
          </div>
          <div>
            <h3 className="font-bold text-gray-900">Rover Vision</h3>
            <p className="text-xs text-gray-500">YOLOv8 Nano inference</p>
          </div>
        </div>
        <div className="flex items-center gap-3">
          {recording && (
            <div className="flex items-center gap-1.5 px-2 py-1 bg-gray-50 text-red-600 rounded-md text-xs font-bold">
              <div className="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse" />
              REC
            </div>
          )}
          <span className="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-1 rounded-md">ESP32-CAM</span>
        </div>
      </div>

      {/* Vision feed */}
      <div className="relative h-64 bg-gray-900 overflow-hidden">
        {/* Simulated environment */}
        <div className="absolute inset-0">
          <div className="absolute inset-0 bg-gradient-to-b from-gray-800 to-gray-900" />
          <div className="absolute inset-0 opacity-40" style={{ backgroundImage: `radial-gradient(ellipse at 50% 50%, rgba(255,255,255,0.1) 0%, transparent 70%)` }} />
        </div>

        {/* Human detection bounding box */}
        {state.humanDetected && showOverlay && (
          <div className="absolute border-2 border-red-500 rounded-sm" style={{ left: "30%", top: "25%", width: "20%", height: "45%" }}>
            <div className="absolute -top-6 left-0 bg-red-500 rounded-t-sm px-2 py-0.5 flex items-center gap-2">
              <span className="text-[10px] font-bold text-gray-900 uppercase tracking-wider">Human</span>
              <span className="text-[10px] font-bold text-red-100">{state.humanConfidence.toFixed(0)}%</span>
            </div>
            <div className="absolute -bottom-6 left-0 bg-black/50 backdrop-blur-sm rounded px-2 py-0.5">
              <span className="text-[10px] text-gray-900">Dist: 8.4m</span>
            </div>
          </div>
        )}

        {/* Cell phone detection box */}
        {showOverlay && (
          <div className="absolute border-2 border-orange-400 rounded-sm" style={{ left: "52%", top: "28%", width: "8%", height: "20%" }}>
            <div className="absolute -top-5 left-0 bg-orange-400 rounded-t-sm px-1.5 py-0.5">
              <span className="text-[9px] font-bold text-gray-900 uppercase">Phone 67%</span>
            </div>
          </div>
        )}

        {/* Top overlay */}
        <div className="absolute top-3 left-3 flex flex-col gap-1">
          <div className="bg-black/40 backdrop-blur-md text-gray-900 text-[10px] font-medium px-2 py-1 rounded">
            ESP32-CAM LIVE
          </div>
          <div className="bg-black/40 backdrop-blur-md text-gray-500 text-[10px] font-medium px-2 py-1 rounded">
            1280×960 · 15fps
          </div>
        </div>

        <div className="absolute top-3 right-3 text-right flex flex-col gap-1 items-end">
          <div className="bg-red-500/80 backdrop-blur-md text-gray-900 text-[10px] font-bold px-2 py-1 rounded">
            Detections: {state.humanDetected ? "2" : "0"}
          </div>
        </div>
      </div>

      {/* Controls */}
      <div className="flex items-center gap-3 px-5 py-3 border-t border-gray-100 bg-white">
        <button
          onClick={() => setShowOverlay(!showOverlay)}
          className={cn(
            "text-xs px-3 py-1.5 rounded-full font-medium transition-colors",
            showOverlay ? "bg-gray-100 text-purple-700" : "bg-gray-100 text-gray-500 hover:bg-gray-200"
          )}
        >
          Overlay
        </button>
        <button
          onClick={() => setRecording(!recording)}
          className={cn(
            "text-xs px-3 py-1.5 rounded-full font-medium transition-colors",
            recording ? "bg-gray-100 text-red-700" : "bg-gray-100 text-gray-500 hover:bg-gray-200"
          )}
        >
          {recording ? "Stop Rec" : "Record"}
        </button>
        <button className="text-xs px-3 py-1.5 rounded-full font-medium bg-gray-100 text-gray-500 hover:bg-gray-200 transition-colors">
          Snapshot
        </button>
        <button className="ml-auto p-1.5 text-gray-500 hover:text-gray-500 hover:bg-gray-50 rounded-lg">
          <Maximize2 className="w-4 h-4" />
        </button>
      </div>
    </div>
  );
}
